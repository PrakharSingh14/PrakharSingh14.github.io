---
import Layout from "@/layouts/Layout.astro";
import { profile, social, template } from "@/settings";
import { projects } from "@/data/projects";
import KeyInterests from "@/components/ui/KeyInterests.astro";

const { thesisTitle, key_interests } = profile;
---

<Layout title="Research | Prakhar Singh">
  <div class="prose max-w-none">
    <div class="flex items-start justify-between gap-4 flex-wrap mb-8">
      <h1 class="text-3xl font-bold m-0">Research</h1>
      {social.github && (
        <a href={social.github} target="_blank" class="btn btn-sm btn-secondary text-secondary-content no-underline">
          View my GitHub
        </a>
      )}
    </div>

    {thesisTitle && (
      <p class="text-lg italic border-l-4 border-accent pl-4 mb-10 text-base-content/80">
        Thesis: "{thesisTitle}"
      </p>
    )}

    <h2 class="text-2xl font-bold mb-6">Research Interest</h2>
    <div class="mb-12">
      <p class="text-lg mb-6">
        My research investigates the energetics and coupled dynamics of solar eruptive phenomena
        — primarily flares and coronal jets — across a range of spatial and temporal scales,
        using coordinated multi-instrument observations from SDO, IRIS, Hinode, Solar Orbiter
        and Aditya-L1.
      </p>
      <p class="text-lg mb-6">
        I combine imaging, spectroscopic diagnostics and magnetic field extrapolation to probe
        the thermal, kinematic and magnetic signatures of these eruptions, with implications for
        coronal heating, solar-wind mass loading and space-weather forecasting.
      </p>
    </div>

    <div class="mb-12">
      <KeyInterests interests={key_interests} />
    </div>

    <h2 class="text-2xl font-bold mb-6">My Work</h2>
    <div class="grid gap-6 mb-12 not-prose">
      {
        projects.map((project) => (
          <a
            href={`${template.base}/research/${project.slug}`}
            class="block p-6 rounded-lg bg-base-200 text-base-content hover:text-accent transition-colors duration-200"
          >
            <h3 class="text-xl font-semibold mb-2">{project.title}</h3>
            <p class="text-base">{project.summary}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
