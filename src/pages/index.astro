---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import Hero from '@/components/ui/Hero.astro'

const { fullName, tagline, key_interests } = profile
---

<Layout>
	<!-- Hero Section -->
	<section class='flex items-center gap-12 pb-12'>
		<Hero
			fullName={fullName}
			tagline={tagline}
		/>
	</section>

	<!-- Key Interests -->
	{key_interests?.length > 0 && (
		<section class='py-12 border-t'>
			<h2 class='text-2xl font-bold mb-6'>Key Interests</h2>
			<div class='flex flex-wrap gap-3'>
				{key_interests.map((interest: string) => (
					<span class='badge badge-lg badge-outline border-accent text-base-content px-4 py-3'>
						{interest}
					</span>
				))}
			</div>
		</section>
	)}
</Layout>
