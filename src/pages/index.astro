---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import Hero from '@/components/ui/Hero.astro'
import KeyInterests from '@/components/ui/KeyInterests.astro'

const { fullName, tagline, key_interests } = profile
---

<Layout>
	<!-- Hero Section -->
	<section class='flex items-center gap-12 pb-12'>
		<Hero
			fullName={fullName}
			tagline={tagline}
		/>
	</section>

	<!-- Key Interests -->
	<section class='py-12 border-t'>
		<KeyInterests interests={key_interests} />
	</section>
</Layout>
