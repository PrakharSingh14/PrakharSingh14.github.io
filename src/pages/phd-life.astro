---
import Layout from "@/layouts/Layout.astro";
import { phdLifeEntries } from "@/data/phd-life";

const imageFiles = import.meta.glob("/src/assets/phd-life/*.{jpg,jpeg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;

const entries = phdLifeEntries
  .map((entry) => ({
    ...entry,
    url: imageFiles[`/src/assets/phd-life/${entry.file}`],
  }))
  .filter((entry) => entry.url);
---

<Layout title="PhD Life | Prakhar Singh">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-4">PhD Life</h1>
    <p class="text-lg mb-10 text-base-content/80">
      Snapshots from life as a PhD student — treks, travel, conferences,
      thesis discussions, and everything in between.
    </p>
  </div>

  {
    entries.length === 0 ? (
      <div class="rounded-xl border border-dashed border-base-300 p-12 text-center text-base-content/60">
        Photos coming soon.
      </div>
    ) : (
      <div class="flex flex-col gap-16">
        {entries.map((entry, index) => (
          <div class={`flex flex-col md:flex-row ${index % 2 === 1 ? 'md:flex-row-reverse' : ''} gap-8 items-center`}>
            <img
              src={entry.url}
              alt={entry.caption}
              class="w-full md:w-1/2 rounded-lg shadow-sm object-cover"
              loading="lazy"
            />
            <p class="w-full md:w-1/2 text-lg text-base-content/80">
              {entry.caption}
            </p>
          </div>
        ))}
      </div>
    )
  }
</Layout>
