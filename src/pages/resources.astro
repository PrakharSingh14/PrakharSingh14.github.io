---
import Layout from "@/layouts/Layout.astro";
import { resourceCategories } from "@/data/resources";
---

<Layout title="Resources | Prakhar Singh">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-4">Resources</h1>
    <p class="text-lg mb-10 text-base-content/80">
      A running list of solar-physics resources, tools and repositories I
      use or maintain.
    </p>
  </div>

  {
    resourceCategories.length === 0 ? (
      <div class="rounded-xl border border-dashed border-base-300 p-12 text-center text-base-content/60">
        Resources coming soon.
      </div>
    ) : (
      <div class="flex flex-col gap-10">
        {resourceCategories.map((category) => (
          <div>
            <h2 class="text-2xl font-bold mb-4">{category.category}</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {category.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  class="px-4 py-3 rounded-lg bg-base-200 text-base-content hover:text-accent transition-colors duration-200 block font-medium"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Layout>
