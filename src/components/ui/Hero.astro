---
import SocialIcons from './SocialIcons.astro'
import { template } from '@/settings'

const {fullName, title, institute} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-base-content/70 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    I study how the Sun releases its stored magnetic energy — from confined and
    eruptive flares to plasmoid-driven jets — using X-ray spectroscopy and
    multi-instrument imaging from Aditya-L1, SDO, IRIS and Hinode.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:flex hidden items-center justify-center'>
  <img
    src={`${template.base}/profile.jpg`}
    alt={fullName}
    class='size-44 rounded-full object-cover aspect-square'
  />
</div>
