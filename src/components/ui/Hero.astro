---
import SocialIcons from './SocialIcons.astro'
import { template } from '@/settings'

const {fullName, tagline} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Hey there! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-base-content/70 mb-4'>{tagline}</p>
  <p class='text-lg mb-6'>
    A researcher in solar physics, studying how the Sun releases its stored magnetic energy through flares and jets.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-80 lg:flex hidden items-center justify-center'>
  <img
    src={`${template.base}/profile.jpg`}
    alt={fullName}
    class='size-56 rounded-full object-cover aspect-square'
  />
</div>
