---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    type: string;
    venue: string;
    time: string;
  }[];
}
const { listTitle, listItems } = Astro.props
---

<h2 class='text-2xl font-bold mb-6'>{listTitle}</h2>
<div class='space-y-4'>
  {
    listItems.map((item) => (
      <div class='p-5 rounded-lg text-base-content bg-base-200'>
        <div class='flex items-start justify-between gap-4 mb-1'>
          <h3 class='text-lg font-semibold'>{item.title}</h3>
          <span class='badge badge-accent whitespace-nowrap'>{item.type}</span>
        </div>
        <p class='text-sm'>{item.venue}</p>
        <p class='text-sm italic text-base-content/70'>{item.time}</p>
      </div>
    ))
  }
</div>
