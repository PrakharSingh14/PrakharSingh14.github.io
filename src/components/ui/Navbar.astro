---
import {profile} from '../../settings'
import SocialIcons from './SocialIcons.astro'
import { getCollection } from 'astro:content'
import { template } from '@/settings'

const isBlogPopulated = await getCollection('blog').then(collection => collection.length > 0)

const {fullName, title} = profile
---
<aside
	class='px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'
>
	<div class='flex flex-col my-8 justify-between h-full'>
		<div>
			<div class='flex justify-center items-center flex-col'>
				<img
					src={`${template.base}/profile.jpg`}
					alt={fullName}
					class='size-44 rounded-full object-cover aspect-square'
				/>
				<div class="mt-8 hidden lg:block text-center">
					<h1 class="text-lg font-black">{fullName}</h1>
					<p class="text-base text-base-content/70 leading-snug">
						{title.split(', ').map((line, i, arr) => <>{line}{i < arr.length - 1 && <br />}</>)}
					</p>
				</div>
			</div>
			<div class='mx-4 mt-16'>
				<ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>
					<li>
                        <a href={`${template.base}/`} class='text-lg'>Home</a>
					</li>
					<li>
                        <a href={`${template.base}/about`} class='text-lg'>About Me</a>
					</li>
					<li>
                        <a href={`${template.base}/research`} class='text-lg'>Research</a>
					</li>
					<li>
                        <a href={`${template.base}/publications`} class='text-lg'>Publications</a>
					</li>
					<li>
                        <a href={`${template.base}/cv`} class='text-lg'>Curriculum Vitae</a>
                    </li>
					<li>
                        <a href={`${template.base}/phd-life`} class='text-lg'>PhD Life</a>
                    </li>
					<li>
                        <a href={`${template.base}/resources`} class='text-lg'>Resources</a>
                    </li>
					<li>
                        <a href={`${template.base}/contact`} class='text-lg'>Contact</a>
                    </li>
                    {isBlogPopulated &&
					<li>
                        <a href={`${template.base}/blog/1`} class='text-lg'>Blog</a>
</li>
                    }
				</ul>
			</div>
		</div>
		<div class='mx-4'>
			<SocialIcons compact/>
		</div>
	</div>
</aside>
